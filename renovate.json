{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "npm",
    "dockerfile",
    "docker-compose",
    "github-actions"
  ],
  "automerge": false,
  "prConcurrentLimit": 3,
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "prisma",
        "@prisma/client"
      ],
      "groupName": "Prisma",
      "prBodyNotes": [
        "Review the scoped @prisma/config override when updating Prisma. Remove it only after confirming the resolved deepmerge-ts version is patched and application and container checks pass."
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
